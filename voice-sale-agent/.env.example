APP_NAME=voice-sale-agent
ENV=dev
DEBUG=true
HOST=0.0.0.0
PORT=8010

# Fill secrets locally. Endpoints mirror the Java application.yml.
DATABASE_URL=postgresql+asyncpg://<user>:<password>@117.72.10.84:5432/jc_voice_shopping
DATABASE_SSL=false
REDIS_URL=redis://:<password>@117.72.56.40:6379/3

DASHSCOPE_API_KEY=<your-dashscope-api-key>
LLM_MAIN_MODEL=qwen-max
LLM_LIGHT_MODEL=qwen-turbo
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIM=1024
ASR_MODEL=paraformer-realtime-v2
TTS_MODEL=cosyvoice-v1
TTS_VOICE=longwan

SESSION_TTL_MINUTES=30
AGENT_TURN_LOCK_TTL_SECONDS=180
MAX_HISTORY_TURNS=10
PERSPECTIVE_ENABLED=true
